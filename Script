-- HDT
-- ─────────────────────────────────────────────────────────────
local function StopHDT()
    if hdtConn then hdtConn:Disconnect(); hdtConn=nil end
end

local function StartHDT(kr, duration)
    if not Settings.HDT or not (kr and kr.Parent) then return end
    StopHDT()
    local t0  = tick()
    local cam = workspace.CurrentCamera
    hdtConn = RunService.RenderStepped:Connect(function()
        if tick()-t0 >= duration then StopHDT(); return end
        if not (kr and kr.Parent and LocalRoot and LocalRoot.Parent) then StopHDT(); return end
        local flat = Vector3.new(kr.Position.X-LocalRoot.Position.X, 0, kr.Position.Z-LocalRoot.Position.Z)
        if flat.Magnitude > 0 then
            LocalRoot.CFrame = CFrame.new(LocalRoot.Position, LocalRoot.Position+flat.Unit)
        end
        if cam then cam.CFrame = CFrame.new(cam.CFrame.Position, kr.Position) end
    end)
end

-- ─────────────────────────────────────────────────────────────
-- FireBlock — single entry point
-- ─────────────────────────────────────────────────────────────
local function FireBlock(reason, kr)
    if tick()-lastBlockAt < COOLDOWN then return end
    -- Check UI cooldown (real Forsaken UI path)
    if not cachedCooldown then refreshUIRefs() end
    if cachedCooldown and cachedCooldown.Text ~= "" then return end

    if blockDelay > 0 then task.wait(blockDelay) end

    lastBlockAt = tick()
    fireRemoteBlock()

    totalBlocks += 1
    if blockLabel then blockLabel:Set({Title="Blocks fired: "..totalBlocks}) end
    if kr then StartHDT(kr, Settings.HDTDuration) end

    WindUI:Notify({
        Title="Blocked!", Content=(reason or "Attack")..(Settings.HDT and " | HDT" or ""),
        Icon="solar:shield-bold", Duration=2,
    })
end

