-- Aimbot (from open-source: tracks killer's predicted position)
-- ─────────────────────────────────────────────────────────────
local PRED_VALUE = 4

local function StopAim()
    if aimConn then aimConn:Disconnect(); aimConn=nil end
    aimActive=false
    local char = LocalCharacter
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then pcall(function() hum.AutoRotate=true end) end
    end
end

local function StartAim(root, duration)
    if aimConn then aimConn:Disconnect() end
    aimActive=true
    local char = LocalCharacter
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum.AutoRotate=false end) end
    local t0 = tick()
    aimConn = RunService.RenderStepped:Connect(function()
        if not aimActive or not Settings.PunchAimbot then StopAim(); return end
        if tick()-t0 >= (duration or 0.8) then StopAim(); return end
        local kr = getNearestKillerRoot()
        if not (kr and root and root.Parent) then return end
        local pred = kr.Position + (kr.CFrame.LookVector * PRED_VALUE)
        pcall(function() root.CFrame = CFrame.lookAt(root.Position, pred) end)
        local cam = workspace.CurrentCamera
        if cam then cam.CFrame = CFrame.new(cam.CFrame.Position, pred) end
    end)
end

