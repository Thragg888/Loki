--// ROLE CACHE (Elite Scripts pattern)[reference:1]
local roleCache = {}

local function getRole(plr)
    if plr == LocalPlayer then return "LocalPlayer" end
    if roleCache[plr] and tick() - roleCache[plr]._t < 0.8 then
        return roleCache[plr].role
    end
    local char = plr.Character
    if not char then
        roleCache[plr] = { role = "None", _t = tick() }
        return "None"
    end

    local hasKnife, hasGun = false, false
    -- Scan equipped tools
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            local n = tool.Name:lower()
            if n:find("knife") or n:find("blade") or n:find("dagger") or n:find("sword") then
                hasKnife = true
            elseif n:find("gun") or n:find("revolver") or n:find("pistol") then
                hasGun = true
            end
        end
    end
    -- Scan backpack
    local bp = plr:FindFirstChild("Backpack")
    if bp then
        for _, tool in ipairs(bp:GetChildren()) do
            if tool:IsA("Tool") then
                local n = tool.Name:lower()
                if n:find("knife") or n:find("blade") or n:find("dagger") then
                    hasKnife = true
                elseif n:find("gun") or n:find("revolver") or n:find("pistol") then
                    hasGun = true
                end
            end
        end
    end

    -- Attribute fallback
    local role = "Innocent"
    local attr = plr:GetAttribute("Role") or char:GetAttribute("Role")
    if attr then
        local r = tostring(attr):lower()
        if r:find("murder") then role = "Murderer"
        elseif r:find("sheriff") or r:find("hero") then role = "Sheriff"
        elseif r:find("innocent") then role = "Innocent" end
    elseif hasKnife then role = "Murderer"
    elseif hasGun then role = "Sheriff"
    end

    roleCache[plr] = { role = role, _t = tick() }
    return role
end

--// SILENT AIM HELPERS
local ValidTargetParts = { "Head", "HumanoidRootPart" }
local ExpectedArguments = {
    FindPartOnRayWithIgnoreList   = { ArgCountRequired = 3, Args = { "Instance", "Ray", "table", "boolean", "boolean" } },
    FindPartOnRayWithWhitelist    = { ArgCountRequired = 3, Args = { "Instance", "Ray", "table", "boolean" } },
    FindPartOnRay                 = { ArgCountRequired = 2, Args = { "Instance", "Ray", "Instance", "boolean", "boolean" } },
    Raycast                       = { ArgCountRequired = 3, Args = { "Instance", "Vector3", "Vector3", "RaycastParams" } },
}

local function validateArgs(args, expected)
    if #args < expected.ArgCountRequired then return false end
    local matches = 0
    for i, a in ipairs(args) do
        if typeof(a) == expected.Args[i] then matches = matches + 1 end
    end
    return matches >= expected.ArgCountRequired
end

local function hitChance()
    local p = math.floor(S.HitChance)
    return math.random() <= p / 100
end

local function isVisible(plr)
    local char = plr.Character
    local lchar = LocalPlayer.Character
    if not char or not lchar then return false end
    local root = FindFirstChild(char, S.TargetPart) or FindFirstChild(char, "HumanoidRootPart")
    if not root then return false end
    local cast = { root.Position, lchar }
    local ignore = { lchar, char }
    return #Camera:GetPartsObscuringTarget(cast, ignore) == 0
end

local function getTarget()
    local closest, bestDist = nil, S.FOV
    local mousePos = GetMouseLocation(UserInputService)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if S.TeamCheck and plr.Team == LocalPlayer.Team then continue end
        if S.VisibleCheck and not isVisible(plr) then continue end

        local char = plr.Character
        if not char then continue end
        local hum = FindFirstChild(char, "Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local hrp = FindFirstChild(char, "HumanoidRootPart")
        if not hrp then continue end

        local screen, onScreen = WorldToViewport(Camera, hrp.Position)
        if not onScreen then continue end

        local d = (mousePos - Vector2.new(screen.X, screen.Y)).Magnitude
        if d < bestDist then
            bestDist = d
            local part
            if S.TargetPart == "Random" then
                part = char[ValidTargetParts[math.random(1, #ValidTargetParts)]]
            else
                part = char[S.TargetPart]
            end
            closest = part or hrp
        end
    end
    return closest
end

--// GUN REMOTE DISCOVERY
-- Scans ReplicatedStorage for RemoteEvents whose names suggest shooting.
local gunRemotes = {}
local function collectGunRemotes()
    gunRemotes = {}
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local n = obj.Name:lower()
            if n:find("shoot") or n:find("fire") or n:find("gun") or n:find("bullet") then
                table.insert(gunRemotes, obj)
                if S.DebugRemote then
                    print("[LarperHub] Gun remote found:", obj:GetFullName())
                end
            end
        end
    end
end
collectGunRemotes()
-- Re-scan when the game adds remotes later
ReplicatedStorage.DescendantAdded:Connect(function(d)
    if d:IsA("RemoteEvent") then
        local n = d.Name:lower()
        if n:find("shoot") or n:find("fire") or n:find("gun") or n:find("bullet") then
            table.insert(gunRemotes, d)
        end
    end
end)

--// ESP
local espCache = {}

local function clearESP()
    for _, data in pairs(espCache) do
        if data.hl then data.hl:Destroy() end
        if data.bb then data.bb:Destroy() end
    end
    espCache = {}
end

local function buildESP(plr, role)
    if espCache[plr] then return end
    local char = plr.Character
    if not char then return end

    local color
    if role == "Murderer" then color = Color3.fromRGB(255, 55, 55)
    elseif role == "Sheriff" then color = Color3.fromRGB(55, 140, 255)
    else color = Color3.fromRGB(80, 220, 120) end

    local hl = Instance.new("Highlight")
    hl.FillColor = color
    hl.OutlineColor = color
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = char

    local bb
    local head = FindFirstChild(char, "Head")
    if head then
        bb = Instance.new("BillboardGui")
        bb.Adornee = head
        bb.Size = UDim2.new(0, 220, 0, 50)
        bb.StudsOffset = Vector3.new(0, 2.4, 0)
        bb.AlwaysOnTop = true

        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.new(1, 0, 1, 0)
        txt.BackgroundTransparency = 1
        txt.Text = role .. " | " .. plr.Name
        txt.TextColor3 = color
        txt.TextScaled = true
        txt.Font = Enum.Font.SourceSansBold
        txt.Parent = bb
        bb.Parent = char
    end
    espCache[plr] = { hl = hl, bb = bb }
end

local function refreshESP()
    if not S.ESP then
        if next(espCache) then clearESP() end
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local role = getRole(plr)
        if role == "None" then continue end

        local show =
            (role == "Murderer" and S.ESPMurderer) or
            (role == "Sheriff" and S.ESPSheriff) or
            (role == "Innocent" and S.ESPInnocent)

        if show then buildESP(plr, role)
        elseif espCache[plr] then
            if espCache[plr].hl then espCache[plr].hl:Destroy() end
            if espCache[plr].bb then espCache[plr].bb:Destroy() end
            espCache[plr] = nil
        end
    end

    -- Dropped gun
    local normal = Workspace:FindFirstChild("Normal")
    local drop = normal and normal:FindFirstChild("GunDrop")
    if drop and S.ESPGunDrop and not espCache["GunDrop"] then
        local hl = Instance.new("Highlight")
        hl.FillColor = Color3.fromRGB(255, 255, 0)
        hl.OutlineColor = Color3.fromRGB(255, 255, 0)
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = drop
        espCache["GunDrop"] = { hl = hl }
    elseif not S.ESPGunDrop and espCache["GunDrop"] then
        if espCache["GunDrop"].hl then espCache["GunDrop"].hl:Destroy() end
        espCache["GunDrop"] = nil
    end
end

--// CAM LOCK
local camConn, camTarget

local function startCamLock()
    if camConn then camConn:Disconnect() end
    camConn = RenderStepped:Connect(function()
        if not S.CamLock then return end
        if not camTarget or not camTarget.Parent then
            camTarget = nil
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and getRole(plr) == "Murderer" then
                    local char = plr.Character
                    if char then
                        camTarget = FindFirstChild(char, "Head") or FindFirstChild(char, "HumanoidRootPart")
                        if camTarget then break end
                    end
                end
            end
            if not camTarget then return end
        end
        local cur = Camera.CFrame
        local look = CFrame.new(cur.Position, camTarget.Position)
        Camera.CFrame = cur:Lerp(look, S.CamLockSmooth)
    end)
end

local function stopCamLock()
    if camConn then camConn:Disconnect() camConn = nil end
    camTarget = nil
end

