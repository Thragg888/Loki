local function getCharFromDescendant(inst)
    if not inst then return nil end
    local m = inst:FindFirstAncestorOfClass("Model")
    return (m and m:FindFirstChildOfClass("Humanoid")) and m or nil
end

local function attemptBlockForSound(sound, id)
    if not Settings.AutoBlock or not Settings.SoundMode then return end
    if not sound or not sound:IsA("Sound") or not sound.IsPlaying then return end
    if not id or not BlockSounds[id] then return end
    local now = tick()
    if soundBlockedUntil[sound] and now < soundBlockedUntil[sound] then return end
    if now - lastBlockAt < 0.35 then return end

    local char = getCharFromDescendant(sound)
    local hr   = char and char:FindFirstChild("HumanoidRootPart")
    if not hr then return end

    local plr = Players:GetPlayerFromCharacter(char)
    if not plr or plr == LocalPlayer then return end

    if not hasLOS(hr) then return end
    if not passesDetection(hr) then return end
    if not isFacing(hr) then return end
    if not (LocalCharacter and LocalCharacter.Parent == SurvivorsFolder) then return end

    soundBlockedUntil[sound] = now + 1.0
    task.spawn(function()
        FireBlock("sound:"..sound.Name, hr)
    end)
end

local function hookSound(sound)
    if not sound or not sound:IsA("Sound") then return end
    if soundHooks[sound] then return end
    local id = extractSoundId(sound)
    soundHooks[sound] = true
    local function handle() attemptBlockForSound(sound, id) end
    local c1 = sound.Played:Connect(handle)
    local c2 = sound:GetPropertyChangedSignal("IsPlaying"):Connect(function()
        if sound.IsPlaying then handle() end
    end)
    local cd; cd = sound.Destroying:Connect(function()
        c1:Disconnect(); c2:Disconnect(); cd:Disconnect()
        soundHooks[sound]=nil; soundBlockedUntil[sound]=nil
    end)
    if sound.IsPlaying then handle() end
end

for _, d in ipairs(KillersFolder:GetDescendants()) do
    if d:IsA("Sound") then hookSound(d) end
end
KillersFolder.DescendantAdded:Connect(function(d)
