-- TRIGGER HOOKS
-- =========================================================
local hookedSounds = setmetatable({}, { __mode = "k" })
local lastSoundFire = setmetatable({}, { __mode = "k" })
local hookedAnims = setmetatable({}, { __mode = "k" })

local function onSoundTrigger(sound)
    local now = tick()
    if lastSoundFire[sound] and now - lastSoundFire[sound] < 0.04 then return end
    lastSoundFire[sound] = now
    local id = sound.SoundId and tostring(sound.SoundId):match("(%d+)")
    if not id or not TRIGGER_SOUNDS[id] then return end
    if BEHEAD_IDS[id] and IGNORE_BEHEAD then return end
    local killer = sound:FindFirstAncestorOfClass("Model")
    if not killer then return end
    _G.SCPHub_LastLoggedID = id
    if LOG_IDS then print("[Azure Hub] Sound: " .. id .. " | Killer: " .. killer.Name) end
    if AB_Cfg.Enabled and AB_Cfg.SoundTrigger then tryBlock(killer) end
end

local function hookSound(sound)
    if hookedSounds[sound] then return end
    hookedSounds[sound] = true
    local conn = sound.Played:Connect(function() onSoundTrigger(sound) end)
    sound.Destroying:Once(function()
        hookedSounds[sound] = nil; lastSoundFire[sound] = nil
        pcall(function() conn:Disconnect() end)
    end)
    if sound.IsPlaying then onSoundTrigger(sound) end
end

local function onAnimTrigger(track, killer)
    local anim = track.Animation
    if not anim then return end
    local animId = tostring(anim.AnimationId):match("(%d+)")
    if not animId or not IS_BLOCK_ANIM[animId] then return end
    if AB_Cfg.Enabled and AB_Cfg.AnimTrigger then tryBlock(killer) end
end

local function hookKillerAnims(killer)
    local hum = killer:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if animator and not hookedAnims[animator] then
        hookedAnims[animator] = true
        animator.AnimationPlayed:Connect(function(track) onAnimTrigger(track, killer) end)
    end
end

