--// SILENT AIM HOOKS

-- 1) Raycast / Namecall hook (works for knife and any other raycast weapon)
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(...)
    local method = getnamecallmethod()
    local args = { ... }
    local self = args[1]

    if S.SilentAim and not checkcaller() and hitChance() then
        -- Raycast-based silent aim
        if self == Workspace then
            local target = getTarget()
            if target then
                if method == "Raycast" and S.Method == "Raycast" then
                    if validateArgs(args, ExpectedArguments.Raycast) then
                        local origin = args[2]
                        args[3] = (target.Position - origin).Unit * 1000
                        return oldNamecall(unpack(args))
                    end
                elseif method == "FindPartOnRay" and S.Method == "FindPartOnRay" then
                    if validateArgs(args, ExpectedArguments.FindPartOnRay) then
                        local ray = args[2]
                        args[2] = Ray.new(ray.Origin, (target.Position - ray.Origin).Unit * 1000)
                        return oldNamecall(unpack(args))
                    end
                end
            end
        end

        -- 2) Gun RemoteEvent hook (works for sheriff's gun)
        if S.GunSilentAim and method == "FireServer" then
            -- Check if self is one of our collected gun remotes
            local isGunRemote = false
            for _, r in ipairs(gunRemotes) do
                if self == r then isGunRemote = true break end
            end
            if isGunRemote then
                local target = getTarget()
                if target then
                    -- Most gun remotes send a direction or position as the first argument.
                    -- We overwrite it with a vector toward the target.
                    local origin = Camera.CFrame.Position
                    local dir = (target.Position - origin).Unit * 1000
                    -- Try to detect which argument is the direction/position
                    for i = 2, #args do
                        if typeof(args[i]) == "Vector3" then
                            args[i] = dir
                            break
                        end
                    end
                    -- If no Vector3 arg, try CFrame
                    for i = 2, #args do
                        if typeof(args[i]) == "CFrame" then
                            args[i] = CFrame.new(origin, target.Position)
                            break
                        end
                    end
                    return oldNamecall(unpack(args))
                end
            end
        end
    end
    return oldNamecall(...)
end))

-- 3) Mouse.Hit / Target hook (optional method)
local oldIndex
oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
    if self == Mouse and S.SilentAim and S.Method == "Mouse.Hit/Target" and not checkcaller() then
        local target = getTarget()
        if target then
            if key == "Target" then return target end
            if key == "Hit" then
                if S.Prediction then
                    local hrp = target.Parent and target.Parent:FindFirstChild("HumanoidRootPart") or target
                    local vel = hrp.AssemblyLinearVelocity or hrp.Velocity or Vector3.zero
                    return target.CFrame + vel * S.PredictionAmount
                end
                return target.CFrame
            end
        end
    end
    return oldIndex(self, key)
end))

