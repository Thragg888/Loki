function SetupLocalCharacter(char)
    local hum  = char:WaitForChild("Humanoid", 10); if not hum  then return end
    local anim = hum:WaitForChild("Animator",   10); if not anim then return end
    local root = char:WaitForChild("HumanoidRootPart", 10); if not root then return end

    anim.AnimationPlayed:Connect(function(track)
        local id = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+") or ""
        if PunchAnimSet[id] and Settings.PunchAimbot then
            StartAim(root, 0.8)
            track.Stopped:Connect(StopAim)
        end
    end)
end

-- ─────────────────────────────────────────────────────────────
-- SetupKiller — triple-path: Sound + Anim ID + Anim Name
-- ─────────────────────────────────────────────────────────────
local function SetupKiller(killer)
    if hookedKillers[killer] then return end
    local hum = killer:FindFirstChildOfClass("Humanoid") or killer:WaitForChild("Humanoid",5)
    if not hum then return end
    local anim = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator",5)
    if not anim then return end
    local kr   = killer:FindFirstChild("HumanoidRootPart") or killer:WaitForChild("HumanoidRootPart",5)
    if not kr  then return end

    local conns = {}

    -- PATH 1: Sound (full hook already handled globally above)
    -- PATH 2: Animation ID check
    table.insert(conns, anim.AnimationPlayed:Connect(function(track)
        if not Settings.AutoBlock or not Settings.AnimIDMode then return end
        local id = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+") or ""
        if not BlockableAnimSet[id] then return end
        if not (LocalCharacter and LocalCharacter.Parent == SurvivorsFolder) then return end
        if not passesDetection(kr) then return end
        if not isFacing(kr) then return end
        if not hasLOS(kr) then return end
        task.delay(LEAD, function()
            if not passesDetection(kr) then return end
            FireBlock("animID:"..id, kr)
        end)
    end))

    -- PATH 3: Animation Name check
    table.insert(conns, anim.AnimationPlayed:Connect(function(track)
        if not Settings.AutoBlock or not Settings.AnimNameMode then return end
        local lower = normalize(track.Name)
        if not BlockableAttacks[lower] then return end
        if not (LocalCharacter and LocalCharacter.Parent == SurvivorsFolder) then return end
        if not passesDetection(kr) then return end
        if not isFacing(kr) then return end
        if not hasLOS(kr) then return end
        task.delay(LEAD, function()
            if not passesDetection(kr) then return end
            FireBlock("animName:"..track.Name, kr)
        end)

        -- Sweep confirmation
        local lh = LocalCharacter and LocalCharacter:FindFirstChild("QueryHitbox")
        if not lh or not Settings.AnimIDMode then return end
        local sweepStop = tick() + math.min(track.Length>0 and track.Length or SWEEP_WINDOW, SWEEP_WINDOW)
        local sp = OverlapParams.new()
        sp.FilterType = Enum.RaycastFilterType.Include; sp.MaxParts=1
        local sweepConn
        sweepConn = RunService.PreSimulation:Connect(function()
            if tick()>sweepStop or not Settings.AutoBlock then sweepConn:Disconnect(); return end
            local kh = killer:FindFirstChild("QueryHitbox")
            lh = LocalCharacter and LocalCharacter:FindFirstChild("QueryHitbox")
            if not (kh and lh) then sweepConn:Disconnect(); return end
            sp.FilterDescendantsInstances={lh}
            local p=Instance.new("Part")
            p.Size=Vector3.new(5.2,6,5.65)*SWEEP_MUL; p.CFrame=kh.CFrame*CFrame.new(0,0,-3.5)
            p.CanCollide=false; p.Anchored=true; p.CastShadow=false; p.Transparency=1; p.Parent=workspace
            local hit=#workspace:GetPartsInPart(p,sp)>0; p:Destroy()
            if hit then FireBlock("sweep:"..track.Name,kr); sweepConn:Disconnect() end
        end)
        table.insert(conns, sweepConn)
    end))

    -- Cleanup
    local cleanConn; cleanConn=killer.AncestorChanged:Connect(function()
        if not killer:IsDescendantOf(workspace) then
            for _,c in ipairs(conns) do pcall(function() c:Disconnect() end) end
            cleanConn:Disconnect(); hookedKillers[killer]=nil
        end
    end)
    hookedKillers[killer]=conns

    WindUI:Notify({Title="Killer Tracked",Content="Watching: "..killer.Name,
        Icon="solar:eye-bold",Duration=3})
end

local function StartWatching()
    for _,k in ipairs(KillersFolder:GetChildren()) do task.spawn(SetupKiller,k) end
    if not folderAddedConn then
        folderAddedConn=KillersFolder.ChildAdded:Connect(function(k) task.wait(0.5); SetupKiller(k) end)
    end
    if not folderRemovedConn then
        folderRemovedConn=KillersFolder.ChildRemoved:Connect(function(k)
            local conns=hookedKillers[k]
            if type(conns)=="table" then for _,c in ipairs(conns) do pcall(function() c:Disconnect() end) end end
            hookedKillers[k]=nil
        end)
    end
end

local function StopWatching()
    if folderAddedConn   then folderAddedConn:Disconnect();   folderAddedConn=nil   end
    if folderRemovedConn then folderRemovedConn:Disconnect(); folderRemovedConn=nil end
    for _,conns in pairs(hookedKillers) do
        if type(conns)=="table" then for _,c in ipairs(conns) do pcall(function() c:Disconnect() end) end end
    end
    hookedKillers={}; StopHDT()
end

