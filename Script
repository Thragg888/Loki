local function handleSkillCheck()
    local ui = findSkillCheckUI()
    if not ui then return false end
    if AUTOGEN.SkillCheckSpamMode then pressSkillKey(); return true end
    local needle, zone
    for _, d in ipairs(ui:GetDescendants()) do
        local n = d.Name:lower()
        if not needle and (n:find("needle") or n:find("pointer") or n:find("marker")) then needle = d end
        if not zone and (n:find("zone") or n:find("target") or n:find("success") or n:find("hit")) then zone = d end
    end
    if needle and zone then
        if needle.Rotation ~= nil and zone.Rotation ~= nil then
            local nr, zr = needle.Rotation % 360, zone.Rotation % 360
            local zs = (zone.Size and math.abs(zone.Size.X.Scale * 360)) or 30
            local diff = math.abs((nr - zr + 180) % 360 - 180)
            if diff <= math.max(zs / 2, 8) then pressSkillKey() end
            return true
        end
        if needle.AbsolutePosition and zone.AbsolutePosition then
            local np = needle.AbsolutePosition.X + needle.AbsoluteSize.X / 2
            local zp = zone.AbsolutePosition.X
            local zw = zone.AbsoluteSize.X
            if np >= zp and np <= zp + zw then pressSkillKey() end
            return true
        end
    end
    local btn = ui:FindFirstChildWhichIsA("TextButton", true) or ui:FindFirstChildWhichIsA("ImageButton", true)
    if btn and firesignalF then pcall(firesignalF, btn.MouseButton1Click); return true end
    pressSkillKey(); return true
end

