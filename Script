-- ESP system (Highlight + BillboardGui with distance label)
-- ─────────────────────────────────────────────────────────────
local ESPColors = {
    killer   = Color3.fromRGB(255,50,50),
    survivor = Color3.fromRGB(50,200,255),
    generator= Color3.fromRGB(255,220,0),
    medkit   = Color3.fromRGB(255,105,180),
    bloxycola= Color3.fromRGB(0,150,255),
}

local function makeHighlight(model, color, fillTransp)
    if model:FindFirstChild("_LarpESP") then return end
    local h = Instance.new("Highlight")
    h.Name="._LarpESP"; h.Adornee=model
    h.FillColor=color; h.OutlineColor=color
    h.FillTransparency=fillTransp or 0.7; h.OutlineTransparency=0
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; h.Parent=model
    espHighlights[model]=h
    return h
end

local function makeBillboard(model, label)
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    if not root then return end
    local bb = Instance.new("BillboardGui")
    bb.Name="_LarpBB"; bb.Size=UDim2.new(0,100,0,30)
    bb.StudsOffset=Vector3.new(0,3.5,0); bb.AlwaysOnTop=true
    bb.MaxDistance=1000; bb.Adornee=root; bb.Parent=model
    local lbl=Instance.new("TextLabel")
    lbl.Name="_lbl"; lbl.Size=UDim2.new(1,0,1,0)
    lbl.BackgroundTransparency=1; lbl.TextColor3=Color3.new(1,1,1)
    lbl.TextStrokeTransparency=0.4; lbl.TextSize=14
    lbl.Font=Enum.Font.SourceSansBold; lbl.Text=label or model.Name
    lbl.Parent=bb
    espBillboards[model]=bb
    return bb, lbl
end

local function removeESP(model)
    local h=espHighlights[model]; if h and h.Parent then h:Destroy() end; espHighlights[model]=nil
    local b=espBillboards[model]; if b and b.Parent then b:Destroy() end; espBillboards[model]=nil
    local c=espGenConns[model]; if c then pcall(function() c:Disconnect() end); espGenConns[model]=nil end
end

local function clearESPCategory(filter)
    for model, _ in pairs(espHighlights) do
        if filter(model) then removeESP(model) end
    end
end

local function setupGeneratorESP(obj)
    if not obj or not obj.Parent then return end
    makeHighlight(obj, ESPColors.generator)
    local _, lbl = makeBillboard(obj, "Generator (0%)")
    local prog = obj:FindFirstChild("Progress")
    if prog and lbl then
        lbl.Text = "Generator ("..math.floor(prog.Value).."%)"
        local c = prog.Changed:Connect(function()
            if lbl.Parent then lbl.Text="Generator ("..math.floor(prog.Value).."%)" end
        end)
        espGenConns[obj]=c
    end
end

local function refreshESP()
    -- Killers
    for model, _ in pairs(espHighlights) do
        local isKiller    = model:IsDescendantOf(KillersFolder)
        local isSurvivor  = model:IsDescendantOf(SurvivorsFolder)
        local isGenerator = model.Name == "Generator"
        local isItem      = model.Name == "Medkit" or model.Name == "BloxyCola"
        if (isKiller and not Settings.ESPKillers) or
           (isSurvivor and not Settings.ESPSurvivors) or
           (isGenerator and not Settings.ESPGenerators) or
           (isItem and not Settings.ESPMedkits and not Settings.ESPBloxyCola) then
            removeESP(model)
        end
    end
    if Settings.ESPKillers then
        for _,k in ipairs(KillersFolder:GetChildren()) do
            if k:FindFirstChildOfClass("Humanoid") and not espHighlights[k] then
                makeHighlight(k, ESPColors.killer); makeBillboard(k, k.Name)
            end
        end
    end
    if Settings.ESPSurvivors then
        for _,s in ipairs(SurvivorsFolder:GetChildren()) do
            if s ~= LocalCharacter and s:FindFirstChildOfClass("Humanoid") and not espHighlights[s] then
                makeHighlight(s, ESPColors.survivor); makeBillboard(s, s.Name)
            end
        end
    end
    if Settings.ESPGenerators then
        for _,obj in ipairs(workspace:GetDescendants()) do
            if obj.Name=="Generator" and obj:IsA("Model") and not espHighlights[obj] then
                setupGeneratorESP(obj)
            end
        end
    end
    if Settings.ESPMedkits or Settings.ESPBloxyCola then
        for _,obj in ipairs(workspace:GetDescendants()) do
            local isM = obj.Name=="Medkit" and Settings.ESPMedkits
            local isB = obj.Name=="BloxyCola" and Settings.ESPBloxyCola
            if (isM or isB) and not espHighlights[obj] then
                makeHighlight(obj, isM and ESPColors.medkit or ESPColors.bloxycola, 0.5)
            end
        end
    end
end

-- Update distance labels + remove stale
local function StartESPLoop()
    if espRunConn then return end
    espRunConn = RunService.Heartbeat:Connect(function()
        if not LocalRoot then return end
        for model, bb in pairs(espBillboards) do
            if not model.Parent then removeESP(model); continue end
            local lbl = bb:FindFirstChild("_lbl")
            local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
            if lbl and root and model.Name ~= "Generator" then
                local dist = math.floor((root.Position - LocalRoot.Position).Magnitude)
                lbl.Text = model.Name.." ["..dist.."]"
            end
        end
    end)
    -- Live hooks for new objects
    KillersFolder.ChildAdded:Connect(function(k)
        task.wait(0.5)
        if Settings.ESPKillers and k:FindFirstChildOfClass("Humanoid") then
            makeHighlight(k, ESPColors.killer); makeBillboard(k, k.Name)
        end
    end)
    SurvivorsFolder.ChildAdded:Connect(function(s)
        task.wait(0.5)
        if Settings.ESPSurvivors and s ~= LocalCharacter and s:FindFirstChildOfClass("Humanoid") then
            makeHighlight(s, ESPColors.survivor); makeBillboard(s, s.Name)
        end
    end)
    workspace.DescendantAdded:Connect(function(d)
        task.wait(0.1)
        if Settings.ESPGenerators and d.Name=="Generator" and d:IsA("Model") and not espHighlights[d] then
            setupGeneratorESP(d)
        end
        if Settings.ESPMedkits and d.Name=="Medkit" and not espHighlights[d] then
            makeHighlight(d, ESPColors.medkit, 0.5)
        end
        if Settings.ESPBloxyCola and d.Name=="BloxyCola" and not espHighlights[d] then
            makeHighlight(d, ESPColors.bloxycola, 0.5)
        end
    end)
end

local function StopESPLoop()
    if espRunConn then espRunConn:Disconnect(); espRunConn=nil end
    for model,_ in pairs(espHighlights) do removeESP(model) end
end

