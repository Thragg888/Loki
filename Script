-- Detection Circle visual (from open-source: CylinderHandleAdornment)
-- ─────────────────────────────────────────────────────────────
local function addDetectionCircle(killer)
    if not killer:FindFirstChild("HumanoidRootPart") then return end
    if detectionCircles[killer] then return end
    local hrp = killer.HumanoidRootPart
    local c = Instance.new("CylinderHandleAdornment")
    c.Name="LarpDetCircle"; c.Adornee=hrp
    c.Color3=Color3.fromRGB(255,255,0); c.AlwaysOnTop=true; c.ZIndex=1
    c.Transparency=0.6; c.Radius=Settings.DetectionRange; c.Height=0.12
    c.CFrame=CFrame.new(0,-(hrp.Size.Y/2+0.05),0)*CFrame.Angles(math.rad(90),0,0)
    c.Parent=hrp; detectionCircles[killer]=c
end

local function removeDetectionCircle(killer)
    local c=detectionCircles[killer]; if c then c:Destroy() end; detectionCircles[killer]=nil
end

RunService.RenderStepped:Connect(function()
    if not LocalRoot then return end
    for killer, circle in pairs(detectionCircles) do
        if not killer.Parent or not killer:FindFirstChild("HumanoidRootPart") then
            removeDetectionCircle(killer); continue
        end
        circle.Radius = Settings.DetectionRange
        local d = (killer.HumanoidRootPart.Position - LocalRoot.Position).Magnitude
        circle.Color3 = d <= Settings.DetectionRange
            and Color3.fromRGB(255,165,0) or Color3.fromRGB(255,255,0)
    end
end)

-- ─────────────────────────────────────────────────────────────
-- Facing visual (CylinderHandleAdornment, from open-source)
-- ─────────────────────────────────────────────────────────────
local function addFacingVisual(killer)
    if not killer or not killer:IsA("Model") then return end
    if facingVisuals[killer] then return end
    local hrp = killer:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local v = Instance.new("CylinderHandleAdornment")
    v.Name="LarpFacingVisual"; v.Adornee=hrp
    v.AlwaysOnTop=true; v.ZIndex=2; v.Transparency=0.55
    v.Color3=Color3.fromRGB(255,255,0)
    local dot  = math.clamp(Settings.FacingDot,-1,1)
    local frac = math.acos(dot)/math.pi
    v.Radius = math.max(1, Settings.DetectionRange*(0.20+(0.80*frac)))
    v.Height = 0.12
    local yOff = -(hrp.Size.Y/2+0.05)
    local fwdD = Settings.DetectionRange*(0.35+0.15*frac)
    v.CFrame = CFrame.new(0,yOff,-fwdD)*CFrame.Angles(math.rad(90),0,0)
    v.Parent = hrp; facingVisuals[killer]=v
end

local function removeFacingVisual(killer)
    local v=facingVisuals[killer]; if v then v:Destroy() end; facingVisuals[killer]=nil
end

RunService.RenderStepped:Connect(function()
    if not LocalRoot then return end
    for killer, visual in pairs(facingVisuals) do
        if not killer.Parent or not killer:FindFirstChild("HumanoidRootPart") then
            removeFacingVisual(killer); continue
        end
        local hrp = killer.HumanoidRootPart
        local d   = (hrp.Position-LocalRoot.Position).Magnitude
        visual.Color3 = d<=Settings.DetectionRange
            and Color3.fromRGB(255,0,0) or Color3.fromRGB(255,255,0)
        visual.Transparency = d<=Settings.DetectionRange and 0.40 or 0.85
    end
end)

KillersFolder.ChildAdded:Connect(function(k)
    if Settings.DetectionCircle then
        task.spawn(function()
            k:WaitForChild("HumanoidRootPart",5); addDetectionCircle(k)
        end)
    end
    if Settings.FacingVisual then
        task.spawn(function()
            k:WaitForChild("HumanoidRootPart",5); addFacingVisual(k)
        end)
    end
end)
KillersFolder.ChildRemoved:Connect(function(k)
    removeDetectionCircle(k); removeFacingVisual(k)
end)

