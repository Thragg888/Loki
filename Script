-- ══════ TAB: Misc ═════════════════════════════════════════════
local MiscTab = Window:Tab({Title="Misc", Icon="box"})
MiscTab:Toggle({Title="Fullbright",Value=false,Flag="Fullbright",
    Callback=function(s)
        Settings.Fullbright=s
        if s then EnableFullbright() else DisableFullbright() end
    end})
MiscTab:Space()
MiscTab:Button({Title="FPS Boost",Icon="gauge",
    Callback=function()
        FPSBoost()
        WindUI:Notify({Title="FPS Boost",Content="Applied!",Icon="solar:cpu-bold",Duration=3})
    end})
MiscTab:Space()
MiscTab:Button({Title="Remove Slowness (Risky)",Icon="wind",Callback=RemoveSlowness})
MiscTab:Space()
MiscTab:Button({Title="Remove Stunned (Risky)",Icon="zap-off",Callback=RemoveStunned})
MiscTab:Space()
MiscTab:Button({Title="Clear Cache",Icon="trash-2",
    Callback=function()
        for _,v in ipairs(workspace:GetChildren()) do
            if v:IsA("Part") and v.Name=="AntiFlickZone" then v:Destroy() end
        end
        pcall(collectgarbage, "collect")
        WindUI:Notify({Title="Cache Cleared",Content="Done!",Icon="solar:trash-bin-trash-bold",Duration=2})
    end})
MiscTab:Space()
MiscTab:Toggle({Title="Debug Notifications",Value=false,Flag="Debug",
    Callback=function(s) Settings.Debug=s end})

-- ══════ TAB: Settings ═════════════════════════════════════════
local SettingsTab = Window:Tab({Title="Settings", Icon="settings"})
SettingsTab:Dropdown({Title="Theme",Flag="Theme",
    Values={"Dark","Light","Rose","Indigo","Violet","Amber","Sky","Plant"},Value=1,
    Callback=function(s) WindUI:SetTheme(s) end})

