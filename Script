local function normalize(s) return s:lower():gsub("%s+","") end

-- Wall check (raycast, from open-source)
local function hasLOS(targetHRP)
    if not Settings.WallCheck then return true end
    if not (LocalRoot and targetHRP) then return true end
    local dir = targetHRP.Position - LocalRoot.Position
    local rp  = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {LocalCharacter, targetHRP.Parent}
    rp.IgnoreWater = true
    local result = workspace:Raycast(LocalRoot.Position, dir, rp)
    return result == nil
end

-- Cone check
local function inCone(kr)
    if not (LocalRoot and kr) then return false end
    local diff = kr.Position - LocalRoot.Position
    if diff.Magnitude > Settings.ConeLength then return false end
    if diff.Magnitude == 0 then return true end
    return LocalRoot.CFrame.LookVector:Dot(diff.Unit) >= math.cos(math.rad(Settings.ConeAngle/2))
end

-- Box check
local function inBox(kr)
    if not (LocalRoot and kr) then return false end
    local diff  = kr.Position - LocalRoot.Position
    local fwd   = diff:Dot(LocalRoot.CFrame.LookVector)
    local lat   = diff:Dot(LocalRoot.CFrame.RightVector)
    local vert  = diff:Dot(LocalRoot.CFrame.UpVector)
    return fwd  >= 0 and fwd  <= Settings.BoxLength
       and math.abs(lat)  <= Settings.BoxWidth/2
       and math.abs(vert) <= Settings.BoxHeight/2
end

local function passesDetection(kr)
    if not (Settings.UseConeCheck or Settings.UseBoxCheck) then
        if not (LocalRoot and kr) then return false end
        return (kr.Position - LocalRoot.Position).Magnitude <= Settings.DetectionRange
    end
    if Settings.UseConeCheck and inCone(kr) then return true end
    if Settings.UseBoxCheck  and inBox(kr)  then return true end
    return false
end

-- Facing check (from open-source: checks killer's LookVector toward us)
local function isFacing(kr)
    if not Settings.FacingCheck then return true end
    if not (LocalRoot and kr) then return true end
    local diff = LocalRoot.Position - kr.Position
    if diff.Magnitude == 0 then return true end
    return kr.CFrame.LookVector:Dot(diff.Unit) > Settings.FacingDot
end

local function getNearestKillerRoot()
    if not LocalRoot then return nil, nil end
    local nearest, nearDist, nearModel = nil, math.huge, nil
    for _, k in ipairs(KillersFolder:GetChildren()) do
        local kr  = k:FindFirstChild("HumanoidRootPart")
        local hum = k:FindFirstChildOfClass("Humanoid")
        if kr and hum and hum.MaxHealth > 500 then
            local d = (LocalRoot.Position - kr.Position).Magnitude
            if d < nearDist then nearDist=d; nearest=kr; nearModel=k end
        end
    end
    return nearest, nearModel
end

local function extractSoundId(sound)
    if not sound then return nil end
    local sid = tostring(sound.SoundId or "")
    return sid:match("rbxassetid://(%d+)") or sid:match("://(%d+)") or sid:match("^(%d+)$")
end

