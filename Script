local ESP_CFG = {
    Killers   = { Enabled = false, TextEnabled = false, FillColor = Color3.fromRGB(255, 40, 40), FillTransparency = 0.55, OutlineTransparency = 0 },
    Survivors = { Enabled = false, TextEnabled = false, FillColor = Color3.fromRGB(40, 255, 90), FillTransparency = 0.55, OutlineTransparency = 0 }
}
local ESP_TRACK = setmetatable({}, { __mode = "k" })

local function espClear(m)
    local t = ESP_TRACK[m]
    if not t then return end
    for _, o in pairs(t) do
        if o and typeof(o) == "Instance" then pcall(function() o:Destroy() end) end
    end
    ESP_TRACK[m] = nil
end

local function espEnsure(m, cfg, isKiller, myHrp)
    if not m or not m.Parent then espClear(m); return end
    local hum = m:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then espClear(m); return end
    if not cfg.Enabled and not cfg.TextEnabled then if ESP_TRACK[m] then espClear(m) end return end
    local t = ESP_TRACK[m]
    if not t then t = {}; ESP_TRACK[m] = t end
    t.IsKiller = isKiller
    if t.Chams and not t.Chams.Parent then t.Chams = nil end
    if cfg.Enabled then
        if not t.Chams then
            local h = Instance.new("Highlight")
            h.Adornee = m
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Parent = m
            t.Chams = h
        end
        t.Chams.FillColor = cfg.FillColor
        t.Chams.OutlineColor = cfg.FillColor
        t.Chams.FillTransparency = cfg.FillTransparency
        t.Chams.OutlineTransparency = cfg.OutlineTransparency
    elseif t.Chams then
        pcall(function() t.Chams:Destroy() end); t.Chams = nil
