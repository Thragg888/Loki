-- FACING VISUAL
-- =========================================================
local facingVisualOn = false
local facingVisuals = {}

local function updateFacingVisual(killer, visual)
    if not (killer and visual and visual.Parent) then return end
    local hrp = killer:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local dot = math.clamp(customFacingDot or -0.3, -1, 1)
    local frac = math.acos(dot) / math.pi
    local radius = math.max(1, AB_Cfg.Range * (0.20 + 0.80 * frac))
    visual.Radius = radius
    visual.Height = 0.12
    local forwardDist = AB_Cfg.Range * (0.35 + 0.15 * frac)
    local yOffset = -(math.min(hrp.Size.Y, 3) / 2 + 0.05)
    visual.CFrame = CFrame.new(0, yOffset, -forwardDist) * CFrame.Angles(0, 0, math.rad(90))
    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    local inRange, facing = false, false
    if myRoot and hrp then
        local dist = (hrp.Position - myRoot.Position).Magnitude
        inRange = dist <= AB_Cfg.Range
        if inRange then facing = isFacing(myRoot, hrp) end
    end
    if inRange and facing then
        visual.Color3 = Color3.fromRGB(0, 255, 0); visual.Transparency = 0.30
    elseif inRange then
        visual.Color3 = Color3.fromRGB(255, 0, 0); visual.Transparency = 0.45
    else
        visual.Color3 = Color3.fromRGB(255, 255, 0); visual.Transparency = 0.80
    end
end

local function addFacingVisual(killer)
    if not killer or not killer:IsA("Model") then return end
    if facingVisuals[killer] and facingVisuals[killer].Parent then return end
    local hrp = killer:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local v = Instance.new("CylinderHandleAdornment")
    v.Name = "FacingCheckVisual"
    v.Adornee = hrp
    v.AlwaysOnTop = true
    v.ZIndex = 2
    v.Transparency = 0.55
    v.Color3 = Color3.fromRGB(255, 255, 0)
    v.Parent = hrp
    facingVisuals[killer] = v
    updateFacingVisual(killer, v)
end

local function removeFacingVisual(killer)
    local v = facingVisuals[killer]
    if v then pcall(function() v:Destroy() end); facingVisuals[killer] = nil end
end

RunService.RenderStepped:Connect(function()
    for killer, visual in pairs(facingVisuals) do
        if not facingVisualOn or not killer.Parent or not killer:FindFirstChild("HumanoidRootPart") then
            removeFacingVisual(killer)
        else
            updateFacingVisual(killer, visual)
        end
    end
end)

