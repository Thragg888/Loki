            AbilityHook._registered += registerAnimsFrom(getAnimsTable(cfg))
        end)
    end
    registerGuestPunchAnims()
end

local bindRetries = 0
local function bindAnimWatch()
    if AbilityHook._animConn then pcall(function() AbilityHook._animConn:Disconnect() end); AbilityHook._animConn = nil end
    local char = lp.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
